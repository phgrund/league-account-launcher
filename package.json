{
  "name": "league-account-launcher",
  "productName": "League Account Launcher",
  "version": "0.0.1",
  "description": "League of Legends account launcher",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never",
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "ISC",
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.leagueaccountlauncher.app",
    "artifactName": "League-Account-Launcher-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "resources/scripts",
        "to": "resources/scripts",
        "filter": ["login.ps1"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/renderer/assets/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  }
}
